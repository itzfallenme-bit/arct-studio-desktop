{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arct Studio",
  "mainBinaryName": "arct-studio",
  "version": "0.1.0",
  "identifier": "dev.arct.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "pnpm build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Arct Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Every Arct tool in one desktop app",
    "longDescription": "Arct Studio brings 40 local-first tools together: writing, spreadsheets, design, media, business, and engineering in one desktop workspace.",
    "copyright": "Copyright 2026 Arct Development",
    "homepage": "https://github.com/itzfallenme-bit/arct-studio-desktop",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "@arctstudio/studio",
  "version": "0.1.0",
  "description": "Arct Studio - 40 local-first productivity tools in one desktop app",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzfallenme-bit/arct-studio-desktop.git"
  },
  "homepage": "https://github.com/itzfallenme-bit/arct-studio-desktop#readme",
  "bugs": {
    "url": "https://github.com/itzfallenme-bit/arct-studio-desktop/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "author": {
    "name": "Arct Development"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc --noEmit",
    "tools:build": "node scripts/build-tools.mjs",
    "tools:finalize": "node scripts/finalize-tools.mjs"
  },
  "dependencies": {
    "@nuclearplayer/i18n": "workspace:*",
    "@nuclearplayer/tailwind-config": "workspace:*",
    "@nuclearplayer/ui": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "lucide-react": "^0.542.0",
    "luxon": "^3.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.0",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@nuclearplayer/eslint-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2.8.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^10.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vite-plugin-svgr": "^5.0.0",
    "vitest": "^5.0.0"
  }
}
